<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Treat as errors -->
    <issue id="UnusedResources" severity="error"/>
    <issue id="HardcodedText" severity="error"/>
    <issue id="MissingTranslation" severity="ignore"/>
    <issue id="InlinedApi" severity="error"/>
    <issue id="ContentDescription" severity="error"/>
    <issue id="ExportedPreferenceActivity" severity="error"/>
    <issue id="AllowBackup" severity="error"/>
    <issue id="Security" severity="error"/>
    <issue id="Deprecated" severity="error"/>

    <!-- Treat as warnings -->
    <issue id="OldTargetApi" severity="warning"/>
    <issue id="UnusedIds" severity="warning"/>
    <issue id="LongLogTag" severity="warning"/>
    <issue id="LogConditional" severity="warning"/>
    <issue id="ViewConstructor" severity="warning"/>
    <issue id="RtlHardcoded" severity="warning"/>

    <!-- Treat as informational -->
    <issue id="NewerVersionAvailable" severity="informational" />
    <issue id="ObsoleteSdkInt" severity="informational"/>
    <issue id="NewApi" severity="informational"/>
    <issue id="GradleDependency" severity="informational"/>
    <issue id="ObsoleteLintCustomCheck" severity="informational"/>
    <issue id="TypographyDashes" severity="informational"/>
    <issue id="TypographyQuotes" severity="informational"/>
</lint>